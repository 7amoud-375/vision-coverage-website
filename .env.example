# ---------------------------------------------------------------------------
# Supabase (required)
# Project dashboard -> Settings -> API
# Both values are safe to expose in the browser; row level security protects data.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Site content (optional - sensible defaults are used when unset)
# ---------------------------------------------------------------------------
# Digits only, international format, no "+" or spaces. Used for the wa.me link.
VITE_WHATSAPP_NUMBER=201234567890
VITE_CONTACT_EMAIL=hello@example.com
VITE_CONTACT_PHONE=+20 123 456 7890
VITE_INSTAGRAM_URL=https://instagram.com/yourhandle
VITE_FACEBOOK_URL=https://facebook.com/yourpage

# ---------------------------------------------------------------------------
# Serverless notification (optional) - only needed if you deploy /api/notify.js
# Set these in the Vercel dashboard, NOT prefixed with VITE_ (server-side only).
# ---------------------------------------------------------------------------
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/xxxx
